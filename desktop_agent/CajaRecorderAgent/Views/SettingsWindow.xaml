<Window x:Class="CajaRecorderAgent.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Height="580" Width="600"
        Icon="pack://application:,,,/Assets/logo.ico"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF7F1EB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">

            <!-- Título principal -->
            <TextBlock Text="Configuración del Agente"
                       FontSize="20" FontWeight="Bold" Foreground="#FFEA6A00"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- ======================== SERVIDOR ======================== -->
            <Border CornerRadius="12" BorderBrush="#FFF2C9A9" BorderThickness="1"
                    Padding="16,12" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFDF3EA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Conexión al Servidor"
                               FontSize="14" FontWeight="SemiBold" Foreground="#FFEA6A00"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="URL del Servidor" Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center" Foreground="#FF5B3A2A" FontWeight="SemiBold"/>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <Border CornerRadius="8" BorderBrush="#FFF2C9A9" BorderThickness="1"
                                    Padding="10,6" Background="#FFF7F1EB">
                                <TextBox x:Name="TxtApiUrl" BorderThickness="0"
                                         Background="Transparent" FontSize="13"
                                         ToolTip="URL del servidor API (ej: http://10.10.10.28:8000)"/>
                            </Border>
                            <TextBlock Text="Ejemplo: http://10.10.10.28:8000"
                                       Foreground="#FF9B7A63" FontSize="11" Margin="4,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================== DISPOSITIVO ======================== -->
            <Border CornerRadius="12" BorderBrush="#FFF2C9A9" BorderThickness="1"
                    Padding="16,12" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFDF3EA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Dispositivo y Asignación"
                               FontSize="14" FontWeight="SemiBold" Foreground="#FFEA6A00"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Micrófono -->
                        <TextBlock Text="Micrófono" Grid.Row="0" Grid.Column="0"
                                   VerticalAlignment="Center" Foreground="#FF5B3A2A" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbMic" Grid.Row="0" Grid.Column="1"
                                  Height="32" Padding="6,4"/>

                        <!-- Número de Caja -->
                        <TextBlock Text="Número de Caja" Grid.Row="2" Grid.Column="0"
                                   VerticalAlignment="Center" Foreground="#FF5B3A2A" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbCaja" Grid.Row="2" Grid.Column="1"
                                  Height="32" Padding="6,4"/>

                        <!-- Cajero -->
                        <TextBlock Text="Cajero" Grid.Row="4" Grid.Column="0"
                                   VerticalAlignment="Center" Foreground="#FF5B3A2A" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbCajero" Grid.Row="4" Grid.Column="1"
                                  Height="32" Padding="6,4"/>

                        <!-- Estado Operativo -->
                        <TextBlock Text="Estado Operativo" Grid.Row="6" Grid.Column="0"
                                   VerticalAlignment="Center" Foreground="#FF5B3A2A" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbEstado" Grid.Row="6" Grid.Column="1"
                                  Height="32" Padding="6,4">
                            <ComboBoxItem Content="Operativa"/>
                            <ComboBoxItem Content="En Mantenimiento"/>
                            <ComboBoxItem Content="Fuera de Servicio"/>
                        </ComboBox>

                        <!-- Duración Segmento -->
                        <TextBlock Text="Tiempo Grabación" Grid.Row="8" Grid.Column="0"
                                   VerticalAlignment="Center" Foreground="#FF5B3A2A" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbDuracion" Grid.Row="8" Grid.Column="1"
                                  Height="32" Padding="6,4">
                            <ComboBoxItem Content="10 Minutos" Tag="10"/>
                            <ComboBoxItem Content="20 Minutos" Tag="20"/>
                            <ComboBoxItem Content="30 Minutos" Tag="30"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================== HORARIOS ======================== -->
            <Border CornerRadius="12" BorderBrush="#FFF2C9A9" BorderThickness="1"
                    Padding="16,12" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFDF3EA" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="Horarios de Grabación"
                               FontSize="14" FontWeight="SemiBold" Foreground="#FFEA6A00"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Mañana Inicio -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Turno Mañana — Inicio"
                                       FontWeight="SemiBold" Foreground="#FF5B3A2A" Margin="0,0,0,6"/>
                            <Border CornerRadius="8" BorderBrush="#FFEA6A00" BorderThickness="1" Padding="10,6">
                                <TextBox x:Name="TxtMananaInicio" BorderThickness="0" FontSize="14"/>
                            </Border>
                            <TextBlock Text="HH:mm (ej: 07:30)" Foreground="#FF9B7A63" FontSize="11" Margin="4,4,0,0"/>
                        </StackPanel>

                        <!-- Mañana Fin -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Turno Mañana — Fin"
                                       FontWeight="SemiBold" Foreground="#FF5B3A2A" Margin="0,0,0,6"/>
                            <Border CornerRadius="8" BorderBrush="#FFEA6A00" BorderThickness="1" Padding="10,6">
                                <TextBox x:Name="TxtMananaFin" BorderThickness="0" FontSize="14"/>
                            </Border>
                            <TextBlock Text="HH:mm (ej: 12:00)" Foreground="#FF9B7A63" FontSize="11" Margin="4,4,0,0"/>
                        </StackPanel>

                        <!-- Tarde Inicio -->
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Turno Tarde — Inicio"
                                       FontWeight="SemiBold" Foreground="#FF5B3A2A" Margin="0,0,0,6"/>
                            <Border CornerRadius="8" BorderBrush="#FFEA6A00" BorderThickness="1" Padding="10,6">
                                <TextBox x:Name="TxtTardeInicio" BorderThickness="0" FontSize="14"/>
                            </Border>
                            <TextBlock Text="HH:mm (ej: 16:00)" Foreground="#FF9B7A63" FontSize="11" Margin="4,4,0,0"/>
                        </StackPanel>

                        <!-- Tarde Fin -->
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Turno Tarde — Fin"
                                       FontWeight="SemiBold" Foreground="#FF5B3A2A" Margin="0,0,0,6"/>
                            <Border CornerRadius="8" BorderBrush="#FFEA6A00" BorderThickness="1" Padding="10,6">
                                <TextBox x:Name="TxtTardeFin" BorderThickness="0" FontSize="14"/>
                            </Border>
                            <TextBlock Text="HH:mm (ej: 19:00)" Foreground="#FF9B7A63" FontSize="11" Margin="4,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================== BOTONES ======================== -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="100" Height="38" Margin="0,0,10,0"
                        Click="Close_Click" Background="#FFF0E6DD" Foreground="#FF6A4A3A"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Guardar" Width="100" Height="38"
                        Click="Save_Click" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF7B889" Offset="0"/>
                            <GradientStop Color="#FFEA6A00" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
